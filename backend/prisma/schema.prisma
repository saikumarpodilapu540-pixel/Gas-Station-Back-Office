// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum PaymentType {
  CASH
  CREDIT
  DEBIT
  EBT
  OTHER
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  password       String
  role           Role         @default(STAFF)
  storeId        String?
  
  // Relations
  store          Store?       @relation("StoreStaff", fields: [storeId], references: [id])
  ownedStores    Store[]      @relation("StoreOwner")
  auditLogs      AuditLog[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
  @@index([storeId])
  @@map("users")
}

model Store {
  id             String       @id @default(uuid())
  name           String
  location       String
  ownerId        String
  
  // Relations
  owner          User         @relation("StoreOwner", fields: [ownerId], references: [id])
  staff          User[]       @relation("StoreStaff")
  inventory      Inventory[]
  sales          Sale[]
  fuelLogs       FuelLog[]
  fuelTanks      FuelTank[]
  expenses       Expense[]
  dailyClosings  DailyClosing[]
  purchases      Purchase[]
  auditLogs      AuditLog[]
  posIntegration PosIntegration?
  posItemMappings PosItemMapping[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([ownerId])
  @@map("stores")
}

model Inventory {
  id             String       @id @default(uuid())
  storeId        String
  productName    String
  category       String
  sku            String       @unique
  costPrice      Decimal      @db.Decimal(10, 2)
  sellingPrice   Decimal      @db.Decimal(10, 2)
  stockQuantity  Int          @default(0)
  reorderLevel   Int          @default(0)

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  posItemMappings PosItemMapping[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([storeId])
  @@index([sku])
  @@map("inventory")
}

model Sale {
  id             String       @id @default(uuid())
  storeId        String
  externalId     String?      // From POS to prevent duplicates
  date           DateTime     @default(now())
  category       String       // e.g., 'fuel', 'store'
  totalAmount    Decimal      @db.Decimal(12, 2)
  paymentType    PaymentType

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([storeId])
  @@index([date])
  @@unique([storeId, externalId])
  @@map("sales")
}

model SaleItem {
  id             String       @id @default(uuid())
  saleId         String
  productId      String
  quantity       Int
  price          Decimal      @db.Decimal(10, 2) // Snapshot of price at time of sale
  cost           Decimal?     @db.Decimal(10, 2) // Snapshot of cost at time of sale

  // Relations
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Inventory    @relation(fields: [productId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model FuelLog {
  id             String       @id @default(uuid())
  storeId        String
  fuelType       String
  type           String       @default("METER") // "METER" or "DELIVERY"
  date           DateTime     @default(now())
  
  // Meter readings (Optional for deliveries)
  openingMeter   Decimal?     @db.Decimal(12, 2)
  closingMeter   Decimal?     @db.Decimal(12, 2)
  gallonsSold    Decimal?     @db.Decimal(10, 2)
  pricePerGallon Decimal?     @db.Decimal(10, 3)
  
  // Delivery data (Optional for meters)
  gallonsReceived Decimal?    @db.Decimal(10, 2)

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([storeId])
  @@map("fuel_logs")
}

model FuelTank {
  id             String       @id @default(uuid())
  storeId        String
  fuelType       String
  tankCapacity   Decimal      @db.Decimal(10, 2)
  currentLevel   Decimal      @db.Decimal(10, 2)

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([storeId])
  @@map("fuel_tanks")
}

model Expense {
  id             String       @id @default(uuid())
  storeId        String
  type           String       // rent, utilities, wages, misc
  amount         Decimal      @db.Decimal(10, 2)
  date           DateTime     @db.Date

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([storeId])
  @@index([date])
  @@map("expenses")
}

model DailyClosing {
  id             String       @id @default(uuid())
  storeId        String
  date           DateTime     @db.Date
  totalSales     Decimal      @db.Decimal(12, 2)
  totalExpenses  Decimal      @db.Decimal(12, 2)
  netProfit      Decimal      @db.Decimal(12, 2)

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([storeId, date]) // Only one closing per store per day
  @@index([storeId])
  @@map("daily_closings")
}

model Vendor {
  id             String       @id @default(uuid())
  name           String
  category       String
  contactInfo    String?

  // Relations
  purchases      Purchase[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("vendors")
}

model Purchase {
  id             String       @id @default(uuid())
  vendorId       String
  storeId        String
  totalCost      Decimal      @db.Decimal(12, 2)
  date           DateTime     @default(now())

  // Relations
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([vendorId])
  @@index([storeId])
  @@map("purchases")
}

model AuditLog {
  id             String       @id @default(uuid())
  storeId        String
  userId         String
  action         String
  module         String
  oldValue       String?      @db.Text
  newValue       String?      @db.Text
  timestamp      DateTime     @default(now())

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@index([module])
  @@map("audit_logs")
}

model PosIntegration {
  id             String       @id @default(uuid())
  storeId        String       @unique
  provider       String       // e.g., 'SQUARE', 'GENERIC'
  apiKey         String
  status         String       @default("ACTIVE")
  lastSync       DateTime?

  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("pos_integrations")
}

model PosItemMapping {
  id             String       @id @default(uuid())
  storeId        String
  posItemName    String       // Exact name from POS
  inventoryId    String       // Mapped inventory item
  
  // Relations
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventory      Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([storeId, posItemName])
  @@index([storeId])
  @@map("pos_item_mappings")
}
