// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum PaymentType {
  CASH
  CREDIT
  DEBIT
  EBT
  OTHER
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(STAFF)
  storeId  String?
  shift    String?

  // Relations
  store       Store?     @relation("StoreStaff", fields: [storeId], references: [id])
  ownedStores Store[]    @relation("StoreOwner")
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([storeId])
  @@map("users")
}

model Store {
  id          String  @id @default(uuid())
  name        String
  location    String
  ownerId     String
  timezone    String  @default("America/Chicago")
  legalEntity String?

  // Relations
  owner           User             @relation("StoreOwner", fields: [ownerId], references: [id])
  staff           User[]           @relation("StoreStaff")
  inventory       Inventory[]
  sales           Sale[]
  fuelLogs        FuelLog[]
  fuelTanks       FuelTank[]
  expenses        Expense[]
  dailyClosings   DailyClosing[]
  purchases       Purchase[]
  auditLogs       AuditLog[]
  posIntegration  PosIntegration?
  posItemMappings PosItemMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("stores")
}

model Inventory {
  id            String          @id @default(uuid())
  storeId       String
  productName   String
  category      String
  sku           String
  catalogId     String
  catalog       Product         @relation(fields: [catalogId], references: [id])
  costPrice     Decimal         @db.Decimal(18, 6)
  sellingPrice  Decimal         @db.Decimal(10, 2)
  stockQuantity Int             @default(0)
  reorderLevel  Int             @default(0)
  taxRate       Decimal         @default(0) @db.Decimal(7, 6)
  archivedAt    DateTime?
  version       Int             @default(0)
  balances      StockBalance[]
  movements     StockMovement[]

  // Relations
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleItems       SaleItem[]
  posItemMappings PosItemMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, sku])
  @@unique([storeId, catalogId])
  @@index([storeId])
  @@index([sku])
  @@map("inventory")
}

model Sale {
  id          String      @id @default(uuid())
  storeId     String
  externalId  String? // From POS to prevent duplicates
  date        DateTime    @default(now())
  category    String // e.g., 'fuel', 'store'
  totalAmount Decimal     @db.Decimal(12, 2)
  paymentType PaymentType
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal     @default(0) @db.Decimal(12, 2)
  cashierId   String?

  // Relations
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, externalId])
  @@index([storeId])
  @@index([date])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String
  productId       String
  quantity        Int
  price           Decimal  @db.Decimal(10, 2) // Snapshot of price at time of sale
  cost            Decimal? @db.Decimal(18, 6) // Cost per sold package at time of sale
  packageId       String?
  packageName     String   @default("Each")
  unitsPerPackage Int      @default(1)
  category        String?
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)

  // Relations
  sale    Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Inventory @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model FuelLog {
  id       String   @id @default(uuid())
  storeId  String
  fuelType String
  type     String   @default("METER") // "METER" or "DELIVERY"
  date     DateTime @default(now())

  // Meter readings (Optional for deliveries)
  openingMeter   Decimal? @db.Decimal(12, 2)
  closingMeter   Decimal? @db.Decimal(12, 2)
  gallonsSold    Decimal? @db.Decimal(10, 2)
  pricePerGallon Decimal? @db.Decimal(10, 3)
  costPerGallon  Decimal? @db.Decimal(10, 3)

  // Delivery data (Optional for meters)
  gallonsReceived Decimal? @db.Decimal(10, 2)

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@map("fuel_logs")
}

model FuelTank {
  id             String  @id @default(uuid())
  storeId        String
  fuelType       String
  tankCapacity   Decimal @db.Decimal(10, 2)
  currentLevel   Decimal @db.Decimal(10, 2)
  pricePerGallon Decimal @default(0) @db.Decimal(10, 3)
  costPerGallon  Decimal @default(0) @db.Decimal(10, 3)

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, fuelType])
  @@index([storeId])
  @@map("fuel_tanks")
}

model Expense {
  id      String   @id @default(uuid())
  storeId String
  type    String // rent, utilities, wages, misc
  amount  Decimal  @db.Decimal(10, 2)
  date    DateTime @db.Date

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([date])
  @@map("expenses")
}

model DailyClosing {
  id              String    @id @default(uuid())
  storeId         String
  date            DateTime  @db.Date
  totalSales      Decimal   @db.Decimal(12, 2)
  totalExpenses   Decimal   @db.Decimal(12, 2)
  netProfit       Decimal   @db.Decimal(12, 2)
  costOfGoodsSold Decimal   @default(0) @db.Decimal(12, 2)
  taxCollected    Decimal   @default(0) @db.Decimal(12, 2)
  status          String    @default("DRAFT")
  closedById      String?
  closedAt        DateTime?
  revision        Int       @default(0)

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, date]) // Only one closing per store per day
  @@index([storeId])
  @@map("daily_closings")
}

model Vendor {
  id          String                @id @default(uuid())
  name        String
  category    String
  contactInfo String?
  ownerId     String?
  archivedAt  DateTime?
  mappings    SupplierItemMapping[]

  // Relations
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("vendors")
}

model Purchase {
  id               String           @id @default(uuid())
  vendorId         String
  storeId          String
  totalCost        Decimal          @db.Decimal(12, 2)
  date             DateTime         @default(now())
  invoiceNumber    String?
  documentId       String?
  document         InvoiceDocument? @relation(fields: [documentId], references: [id])
  subtotal         Decimal          @default(0) @db.Decimal(12, 2)
  discount         Decimal          @default(0) @db.Decimal(12, 2)
  extraCharges     Decimal          @default(0) @db.Decimal(12, 2)
  chargesTreatment String           @default("CAPITALIZE")
  approvedById     String?
  source           String           @default("INVOICE")
  noReceiptReason  String?
  status           String           @default("POSTED")
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  chargesExpenseId String?
  lines            PurchaseLine[]

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Active invoice uniqueness is enforced by partial indexes in the Phase 4 migration.
  @@index([vendorId, invoiceNumber])
  @@index([vendorId])
  @@index([storeId])
  @@map("purchases")
}

model AuditLog {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  action    String
  module    String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  timestamp DateTime @default(now())

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@index([module])
  @@map("audit_logs")
}

model PosIntegration {
  id       String    @id @default(uuid())
  storeId  String    @unique
  provider String // e.g., 'SQUARE', 'GENERIC'
  apiKey   String
  status   String    @default("ACTIVE")
  lastSync DateTime?

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pos_integrations")
}

model PosItemMapping {
  id          String @id @default(uuid())
  storeId     String
  posItemName String // Exact name from POS
  inventoryId String // Mapped inventory item

  // Relations
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, posItemName])
  @@index([storeId])
  @@map("pos_item_mappings")
}

// Shared by stores belonging to one owner. Existing inventory IDs remain stable.
model Product {
  id        String           @id @default(uuid())
  ownerId   String
  sku       String
  name      String
  category  String
  baseUnit  String           @default("each")
  createdAt DateTime         @default(now())
  packages  ProductPackage[]
  inventory Inventory[]

  @@unique([ownerId, sku])
  @@map("products")
}

model ProductPackage {
  id              String          @id @default(uuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  name            String
  unitsPerPackage Int
  barcode         String?
  createdAt       DateTime        @default(now())
  balances        StockBalance[]
  movements       StockMovement[]

  @@unique([productId, name])
  @@unique([productId, barcode])
  @@map("product_packages")
}

model StockBalance {
  id           String         @id @default(uuid())
  inventoryId  String
  inventory    Inventory      @relation(fields: [inventoryId], references: [id])
  packageId    String
  package      ProductPackage @relation(fields: [packageId], references: [id])
  location     String         @default("BACKROOM")
  quantity     Int            @default(0)
  reserved     Int            @default(0)
  sellingPrice Decimal?       @db.Decimal(12, 2)
  updatedAt    DateTime       @updatedAt

  @@unique([inventoryId, packageId, location])
  @@map("stock_balances")
}

model StockOperation {
  id          String          @id @default(uuid())
  ownerId     String
  actorId     String
  key         String
  requestHash String
  result      Json?
  createdAt   DateTime        @default(now())
  movements   StockMovement[]

  @@unique([ownerId, key])
  @@map("stock_operations")
}

model StockMovement {
  id            String         @id @default(uuid())
  operationId   String
  operation     StockOperation @relation(fields: [operationId], references: [id])
  storeId       String
  inventoryId   String
  inventory     Inventory      @relation(fields: [inventoryId], references: [id])
  packageId     String
  package       ProductPackage @relation(fields: [packageId], references: [id])
  location      String
  kind          String
  quantity      Int
  baseUnits     Int
  reservedDelta Int            @default(0)
  unitCost      Decimal        @db.Decimal(18, 6)
  reason        String
  reference     String?
  createdAt     DateTime       @default(now())

  @@index([storeId, createdAt])
  @@index([inventoryId, createdAt])
  @@map("stock_movements")
}

model StockTransfer {
  id                 String                 @id @default(uuid())
  ownerId            String
  number             String                 @unique
  sourceStoreId      String
  destinationStoreId String
  status             String                 @default("DRAFT")
  notes              String                 @default("")
  createdById        String
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  totalCost          Decimal                @default(0) @db.Decimal(18, 6)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  lines              StockTransferLine[]
  receipts           TransferReceipt[]
  allocations        SettlementAllocation[]

  @@index([ownerId, createdAt])
  @@index([sourceStoreId, destinationStoreId])
  @@map("stock_transfers")
}

model StockTransferLine {
  id                   String        @id @default(uuid())
  transferId           String
  transfer             StockTransfer @relation(fields: [transferId], references: [id])
  sourceInventoryId    String
  productId            String
  packageId            String
  sourceLocation       String
  productName          String
  sku                  String
  packageName          String
  unitsPerPackage      Int
  quantity             Int
  received             Int           @default(0)
  returned             Int           @default(0)
  returnedAfterReceipt Int           @default(0)
  damaged              Int           @default(0)
  unitCost             Decimal       @db.Decimal(18, 6)
  sellingPrice         Decimal       @db.Decimal(12, 2)

  @@index([transferId])
  @@map("stock_transfer_lines")
}

model TransferReceipt {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id])
  actorId    String
  kind       String
  details    Json
  notes      String
  createdAt  DateTime      @default(now())

  @@map("transfer_receipts")
}

model Settlement {
  id          String                 @id @default(uuid())
  ownerId     String
  fromStoreId String
  toStoreId   String
  checkNumber String
  checkDate   DateTime               @db.Date
  amount      Decimal                @db.Decimal(12, 2)
  status      String                 @default("ISSUED")
  notes       String                 @default("")
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  allocations SettlementAllocation[]

  @@unique([ownerId, fromStoreId, checkNumber])
  @@map("settlements")
}

model SettlementAllocation {
  id           String        @id @default(uuid())
  settlementId String
  settlement   Settlement    @relation(fields: [settlementId], references: [id])
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)

  @@unique([settlementId, transferId])
  @@map("settlement_allocations")
}

model InvoiceDocument {
  id           String    @id @default(uuid())
  ownerId      String
  storeId      String
  filename     String
  mimeType     String
  sha256       String
  bytes        Bytes
  status       String    @default("UPLOADED")
  extraction   Json?
  reviewDraft  Json?
  error        String?
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  purchases    Purchase[]

  @@unique([ownerId, sha256])
  @@index([storeId, createdAt])
  @@map("invoice_documents")
}

model PurchaseLine {
  id                  String   @id @default(uuid())
  purchaseId          String
  purchase            Purchase @relation(fields: [purchaseId], references: [id])
  inventoryId         String
  packageId           String
  productName         String
  supplierDescription String
  packageName         String
  unitsPerPackage     Int
  quantity            Int
  unitCost            Decimal  @db.Decimal(18, 6)
  lineCost            Decimal  @db.Decimal(18, 6)
  landedUnitCost      Decimal  @default(0) @db.Decimal(18, 6)
  costBefore          Decimal? @db.Decimal(18, 6)
  versionAfter        Int?
  location            String

  @@map("purchase_lines")
}

model SupplierItemMapping {
  id          String @id @default(uuid())
  vendorId    String
  vendor      Vendor @relation(fields: [vendorId], references: [id])
  description String
  productId   String
  packageId   String

  @@unique([vendorId, description])
  @@map("supplier_item_mappings")
}
